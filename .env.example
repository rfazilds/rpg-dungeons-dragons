# ============================================================================
# BANCO DE DADOS NEON POSTGRESQL (Serverless)
# ============================================================================
# Obtenha sua Connection String no console do Neon (https://console.neon.tech)
DATABASE_URL="postgresql://neondb_owner:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ============================================================================
# AUTH.JS / NEXTAUTH v5
# ============================================================================
# Gere um segredo seguro com: npx auth secret (ou openssl rand -base64 32)
AUTH_SECRET="gere-um-segredo-criptografico-aqui-32-bytes"
AUTH_URL="http://localhost:3000"

# Provedor Google OAuth (Google Cloud Console -> APIs & Services -> Credentials)
# Callback URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID="seu-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="seu-client-secret-google"

# ============================================================================
# E-MAILS TRANSACIONAIS (RESEND)
# ============================================================================
# Obtenha sua API Key em https://resend.com/api-keys
RESEND_API_KEY="re_sua_chave_api_do_resend"
EMAIL_FROM="Salão da Guilda <onboarding@resend.dev>"
